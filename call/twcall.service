[Unit]
Description=Taiwan phone remote calling bridge
After=ofono.service bluetooth.service network-online.target
Requires=ofono.service bluetooth.service
# Restart with either daemon so the audio agent and D-Bus matches are registered again.
PartOf=ofono.service bluetooth.service

[Service]
ExecStart=/opt/twcall/venv/bin/python /opt/twcall/twcall.py
WorkingDirectory=/opt/twcall
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
