<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.navbutton" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="24" />
    <application android:label="Back Button" android:hasCode="true">
        <!-- An accessibility service so the button can press Back and Home. It
             reads no screen content: no event types are subscribed to. -->
        <service android:name=".NavService" android:label="Back Button"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>
    </application>
</manifest>
